# Required runtime configuration. Set real values only in a local .env file or
# your deployment secret manager; never commit them.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
SECRET_KEY=REPLACE_WITH_A_GENERATED_SECRET__THIS_VALUE_IS_REJECTED
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Application configuration
API_URL=http://127.0.0.1:8000
ANALYTICS_EXCEL_PATH=analytics/analytics.xlsx
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000
